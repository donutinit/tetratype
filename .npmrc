# Nada de rangos: todo se guarda con versión exacta.
save-exact=true
# Ningún paquete ejecuta scripts de ciclo de vida. Si uno lo necesita, se lee y se corre a mano.
ignore-scripts=true
# Sin registros alternativos ni scopes privados.
registry=https://registry.npmjs.org/
engine-strict=true
fund=false

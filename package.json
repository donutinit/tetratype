{
  "name": "tetratype",
  "version": "0.2.1",
  "private": true,
  "description": "Privacy-first n-gram latency profiler for Monkeytype.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "build:xpi": "node scripts/build.ts --xpi",
    "dev": "node scripts/build.ts --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@happy-dom/global-registrator": "20.14.0",
    "@types/firefox-webext-browser": "120.0.5",
    "@types/node": "22.20.4",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "web-ext": "10.7.0"
  }
}
